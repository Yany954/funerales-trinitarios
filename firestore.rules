rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo cuentas creadas por un administrador (tienen rol). Una cuenta que
    // alguien registre por su cuenta, sin rol, no puede leer nada.
    function estaAutenticado() {
      return request.auth != null && request.auth.token.rol in ['admin', 'empleado'];
    }
    function esAdmin() { return request.auth.token.rol == "admin"; }
    function miSede() { return request.auth.token.sede; }

    // Titular de la app móvil: solo puede leer LO SUYO. Su afiliadoId viene
    // del token (lo pone el backend al registrarse), no de lo que mande la app.
    function esAfiliadoDueno(afiliadoId) {
      return request.auth != null
        && request.auth.token.rol == 'afiliado'
        && request.auth.token.afiliadoId == afiliadoId;
    }

    match /afiliados/{id} {
      allow read: if (estaAutenticado() && (esAdmin() || resource.data.sede == miSede()))
        || esAfiliadoDueno(id);
      allow write: if false;
    }

    // Vínculo titular ↔ cuenta de la app. El staff ve si ya tiene cuenta.
    match /cuentas_afiliado/{afiliadoId} {
      allow read: if (estaAutenticado() && (esAdmin() || resource.data.sede == miSede()))
        || esAfiliadoDueno(afiliadoId);
      allow write: if false;
    }
    // Solo el backend: hashes de códigos e intentos fallidos.
    match /codigos_activacion/{id}     { allow read, write: if false; }
    match /intentos_registro_app/{id}  { allow read, write: if false; }
    match /servicios/{id} {
      allow read: if estaAutenticado() && (esAdmin() || resource.data.sede == miSede());
      allow write: if false;
    }
    match /pagos/{id} {
      allow read: if estaAutenticado() && (esAdmin() || resource.data.sede == miSede());
      allow write: if false;
    }
    match /bovedas/{id} {
      allow read: if estaAutenticado() && (esAdmin() || resource.data.sede == miSede());
      allow write: if false;
    }
    match /inventario_cofres/{id} {
      allow read: if estaAutenticado() && (esAdmin() || resource.data.sede == miSede());
      allow write: if false;
    }

    match /convenios/{document=**}   { allow read: if estaAutenticado(); allow write: if false; }
    match /tipos_cofre/{id}          { allow read: if estaAutenticado(); allow write: if false; }
    match /flores/{id}               { allow read: if estaAutenticado(); allow write: if false; }
    match /planes_funerarios/{id}    { allow read: if estaAutenticado(); allow write: if false; }
    match /personas_cubiertas/{id}   { allow read: if estaAutenticado(); allow write: if false; }
    match /items_boveda/{id}         { allow read: if estaAutenticado(); allow write: if false; }

    // Reglas especiales para collectionGroup (subcolecciones "tarifas" de
    // convenios e "historial" de planes) — Firestore las exige aparte.
    match /{path=**}/tarifas/{anioId} {
      allow read: if estaAutenticado();
      allow write: if false;
    }
    match /{path=**}/historial/{anioId} {
      allow read: if estaAutenticado();
      allow write: if false;
    }
  }
}