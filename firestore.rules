rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() { return request.auth != null; }
    function esAdmin() { return request.auth.token.rol == "admin"; }
    function miSede() { return request.auth.token.sede; }

    match /afiliados/{id} {
      allow read: if estaAutenticado() && (esAdmin() || resource.data.sede == miSede());
      allow write: if false;
    }
    match /servicios/{id} {
      allow read: if estaAutenticado() && (esAdmin() || resource.data.sede == miSede());
      allow write: if false;
    }
    match /pagos/{id} {
      allow read: if estaAutenticado() && (esAdmin() || resource.data.sede == miSede());
      allow write: if false;
    }
    match /bovedas/{id} {
      allow read: if estaAutenticado() && (esAdmin() || resource.data.sede == miSede());
      allow write: if false;
    }
    match /inventario_cofres/{id} {
      allow read: if estaAutenticado() && (esAdmin() || resource.data.sede == miSede());
      allow write: if false;
    }

    match /convenios/{document=**}   { allow read: if estaAutenticado(); allow write: if false; }
    match /tipos_cofre/{id}          { allow read: if estaAutenticado(); allow write: if false; }
    match /flores/{id}               { allow read: if estaAutenticado(); allow write: if false; }
    match /planes_funerarios/{id}    { allow read: if estaAutenticado(); allow write: if false; }
    match /personas_cubiertas/{id}   { allow read: if estaAutenticado(); allow write: if false; }
    match /items_boveda/{id}         { allow read: if estaAutenticado(); allow write: if false; }

    // Reglas especiales para collectionGroup (subcolecciones "tarifas" de
    // convenios e "historial" de planes) — Firestore las exige aparte.
    match /{path=**}/tarifas/{anioId} {
      allow read: if estaAutenticado();
      allow write: if false;
    }
    match /{path=**}/historial/{anioId} {
      allow read: if estaAutenticado();
      allow write: if false;
    }
  }
}