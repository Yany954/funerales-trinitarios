# Copia este archivo como .env.local y llena los valores (la config web pública
# de Firebase, la misma del dashboard: Consola > Configuración del proyecto).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=funerales-trinitarios
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Desarrollo con emuladores (firebase emulators:start):
EXPO_PUBLIC_USAR_EMULADORES=true
# IP de tu Mac en la red Wi-Fi si pruebas en un celular físico (ej. 192.168.1.20).
# Simulador iOS: 127.0.0.1 · Emulador Android: 10.0.2.2 (se elige solo si lo dejas vacío).
EXPO_PUBLIC_EMULADOR_HOST=
