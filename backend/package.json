{
  "name": "funeraria-trinitarios-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud Functions (admin-api) para el sistema de Funerales Los Trinitarios S.A.S.",
  "main": "lib/interfaces/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions",
    "lint": "eslint src --ext .ts",
    "test": "tsx --test tests/cuenta-app.test.ts tests/registro-cuenta.test.ts",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-reglas-afiliado \"tsx --test tests/reglas-afiliado.test.ts\""
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^8.57.0",
    "firebase": "^13.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4"
  }
}
