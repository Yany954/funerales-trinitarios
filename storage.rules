rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Solo cuentas creadas por un administrador (tienen rol). Una cuenta que
    // alguien registre por su cuenta, sin rol, no puede leer nada.
    function estaAutenticado() {
      return request.auth != null && request.auth.token.rol in ['admin', 'empleado'];
    }
    // Los documentos que sube la app son fotos o PDF; nada de HTML, scripts, etc.
    function esImagenOPdf() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/pdf';
    }

    // El control de acceso real vive en las Cloud Functions (admin-api),
    // no aquí. Storage solo exige estar autenticado — cualquier intento de
    // escritura sin pasar por una función válida no tiene con qué crear el
    // documento de Firestore que le da sentido al archivo, así que un
    // archivo "huérfano" no representa un riesgo real.

    match /cofres/{allPaths=**} {
      allow read: if estaAutenticado();
      allow write: if estaAutenticado()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /flores/{allPaths=**} {
      allow read: if estaAutenticado();
      allow write: if estaAutenticado()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /servicios/{allPaths=**} {
      allow read: if estaAutenticado();
      allow write: if estaAutenticado()
        && request.resource.size < 15 * 1024 * 1024
        && esImagenOPdf();
    }
    match /pagos/{allPaths=**} {
      allow read: if estaAutenticado();
      allow write: if estaAutenticado()
        && request.resource.size < 15 * 1024 * 1024
        && esImagenOPdf();
    }

    match /{allPaths=**} {
      allow read: if estaAutenticado();
      allow write: if false;
    }

    // Foto de perfil del titular (app móvil): solo en SU carpeta, solo imágenes
    // de hasta 5 MB. El backend (actualizarPerfilAfiliadoFn) vuelve a validar
    // la ruta antes de guardarla en el afiliado.
    match /perfiles/{afiliadoId}/{archivo} {
      allow read: if estaAutenticado()
        || (request.auth != null && request.auth.token.rol == 'afiliado' && request.auth.token.afiliadoId == afiliadoId);
      allow write: if request.auth != null
        && request.auth.token.rol == 'afiliado'
        && request.auth.token.afiliadoId == afiliadoId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /afiliados/{allPaths=**} {
      allow read: if estaAutenticado();
      allow write: if estaAutenticado()
        && request.resource.size < 15 * 1024 * 1024
        && esImagenOPdf();
    }
    match /{path=**}/historial/{anioId} {
  allow read: if estaAutenticado();
  allow write: if false;
}
  }
}